# Keystatic GitHub Integration
# These variables enable Keystatic to use GitHub as the content source in production.
# They are required for the admin UI to work on your deployed site.
#
# To set up GitHub OAuth:
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App with:
#    - Application name: Ankersted Web CMS
#    - Homepage URL: https://yourdomain.com
#    - Authorization callback URL: https://yourdomain.com/keystatic/github/callback
# 3. Copy the Client ID and Client Secret below
#
# For the KEYSTATIC_SECRET:
# Generate using: openssl rand -hex 32

# GitHub OAuth Client ID (from GitHub OAuth app settings)
KEYSTATIC_GITHUB_CLIENT_ID=

# GitHub OAuth Client Secret (from GitHub OAuth app settings)
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Keystatic security token (generate with: openssl rand -hex 32)
KEYSTATIC_SECRET=

# GitHub repository slug for Keystatic operations (format: owner/repo)
# This should match your repository where content is stored
KEYSTATIC_GITHUB_REPO_SLUG=alexhornbake/ankersted-web

# (Optional) GitHub branch where content is stored (defaults to main)
KEYSTATIC_GITHUB_BRANCH=main
