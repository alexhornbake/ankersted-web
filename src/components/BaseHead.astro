---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, pathWithoutLocale, type Locale } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	image?: string;
	lang?: Locale;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/images/hero-inspiration.jpg',
	lang = defaultLocale,
} = Astro.props;

const rest = pathWithoutLocale(Astro.url.pathname);
const daHref =
	rest !== null
		? new URL(getRelativeLocaleUrl('da', rest), Astro.site).href
		: undefined;
const enHref =
	rest !== null
		? new URL(getRelativeLocaleUrl('en', rest), Astro.site).href
		: undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/fraunces-opsz.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{daHref && enHref && (
	<>
		<link rel="alternate" hreflang="da" href={daHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={daHref} />
	</>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:locale" content={lang === 'da' ? 'da_DK' : 'en_GB'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
