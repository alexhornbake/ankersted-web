---
import { getEntry, render } from 'astro:content';
import { defaultLocale, getLangFromPath, type Locale } from '../i18n/ui';

interface Props {
	lang?: Locale;
}

const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname) ?? defaultLocale;
const footerEntry = await getEntry('footer', lang);
const { Content } = footerEntry ? await render(footerEntry) : { Content: null };
---

<footer>
	{Content && <Content />}
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
