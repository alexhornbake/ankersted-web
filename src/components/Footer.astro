---
import { getEntry, render } from 'astro:content';

const footerEntry = await getEntry('footer', 'index');
const { Content } = footerEntry ? await render(footerEntry) : { Content: null };
---

<footer>
	{Content && <Content />}
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
