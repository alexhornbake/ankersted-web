---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_TITLE } from '../consts';
import { t, type Locale } from '../i18n/ui';

interface Props {
	lang: Locale;
	headline: string;
	heroImage?: string;
}

const { lang, headline, heroImage = '/images/hero-inspiration.jpg' } = Astro.props;
const praktiskHref = getRelativeLocaleUrl(lang, 'praktisk-information');
const baggrundHref = getRelativeLocaleUrl(lang, 'baggrund');
---

<div class="home">
	<section class="hero" aria-label={SITE_TITLE}>
		<div class="hero-media" aria-hidden="true">
			<img
				class="hero-img"
				src={heroImage}
				alt=""
				width={1024}
				height={571}
				fetchpriority="high"
			/>
			<div class="hero-scrim"></div>
		</div>
		<div class="hero-content">
			<p class="brand">{SITE_TITLE}</p>
			<h1 class="headline">{headline}</h1>
			<p class="lede">
				<slot name="lede" />
			</p>
			<div class="cta-row">
				<a class="cta cta-primary" href={praktiskHref}>{t(lang, 'ctaPractical')}</a>
				<a class="cta cta-secondary" href={baggrundHref}>{t(lang, 'ctaBackground')}</a>
			</div>
		</div>
	</section>

	<section class="below">
		<div class="prose">
			<slot />
		</div>
	</section>
</div>

<style>
	.home {
		width: 100%;
	}

	.hero {
		position: relative;
		min-height: 28rem;
		height: min(100svh, 36rem);
		max-height: 36rem;
		display: flex;
		align-items: flex-end;
		color: var(--surface);
		overflow: hidden;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 45%;
		display: block;
		border-radius: 0;
		transform: scale(1.04);
		animation: heroSettle 8s ease-out forwards;
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				to top,
				rgba(42, 38, 32, 0.82) 0%,
				rgba(42, 38, 32, 0.55) 38%,
				rgba(42, 38, 32, 0.28) 70%,
				rgba(42, 38, 32, 0.22) 100%
			);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		width: min(40rem, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 5.5rem 0 2.25rem;
		animation: riseIn 0.7s ease-out both;
	}

	.brand {
		font-family: var(--font-display);
		font-optical-sizing: auto;
		font-size: clamp(2.35rem, 6.5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.025em;
		margin: 0 0 0.5rem;
		color: var(--surface);
	}

	.headline {
		font-family: var(--font-display);
		font-optical-sizing: auto;
		font-size: clamp(1.2rem, 2.8vw, 1.55rem);
		font-weight: 600;
		line-height: 1.3;
		margin: 0 0 0.75rem;
		color: var(--surface);
		max-width: 22ch;
	}

	.lede {
		font-family: var(--font-body);
		font-size: clamp(1rem, 2vw, 1.1rem);
		line-height: 1.6;
		margin: 0 0 1.35rem;
		max-width: 36em;
		color: color-mix(in srgb, var(--surface) 92%, transparent);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
	}

	.cta {
		display: inline-block;
		font-family: var(--font-display);
		font-optical-sizing: auto;
		font-size: 0.98rem;
		font-weight: 600;
		text-decoration: none;
		padding: 0.7rem 1.2rem;
		border-radius: 4px;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease,
			opacity 0.25s ease;
	}

	.cta-primary {
		background: var(--surface);
		color: var(--olive-dark);
	}

	.cta-primary:hover {
		background: var(--olive-soft);
		color: var(--olive-dark);
	}

	.cta-secondary {
		background: transparent;
		color: var(--surface);
		border: 1px solid color-mix(in srgb, var(--surface) 55%, transparent);
	}

	.cta-secondary:hover {
		border-color: var(--surface);
		color: var(--surface);
		background: color-mix(in srgb, var(--surface) 10%, transparent);
	}

	.below {
		width: min(40rem, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 3rem 0 4rem;
	}

	.prose {
		color: var(--ink);
	}

	.prose :global(p) {
		margin-bottom: 0;
		font-size: 1.05rem;
		line-height: 1.75;
	}

	@keyframes riseIn {
		from {
			opacity: 0;
			transform: translateY(0.85rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes heroSettle {
		from {
			transform: scale(1.04);
		}
		to {
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-img {
			animation: none;
			transform: none;
		}
		.hero-content {
			animation: none;
		}
	}

	@media (max-width: 720px) {
		.hero-content {
			padding: 5rem 0 1.75rem;
		}
		.below {
			padding: 2.25rem 0 3rem;
		}
	}
</style>
