---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { defaultLocale, t, type Locale } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: string;
	lang?: Locale;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	lang = defaultLocale,
} = Astro.props;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
	</head>

	<body class="inner-page">
		<div class="page-atmosphere" aria-hidden="true"></div>
		<Header lang={lang} atmosphere />
		<main>
			<article>
				<header class="title">
					{
						pubDate && (
							<div class="date">
								<FormattedDate date={pubDate} lang={lang} />
								{updatedDate && (
									<div class="last-updated-on">
										{t(lang, 'lastUpdatedOn')}{' '}
										<FormattedDate date={updatedDate} lang={lang} />
									</div>
								)}
							</div>
						)
					}
					<h1>{title}</h1>
					{description && <p class="page-desc">{description}</p>}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style is:global>
	body.inner-page {
		position: relative;
		background: var(--ground);
	}

	body.inner-page .page-atmosphere {
		position: absolute;
		inset: 0 0 auto;
		height: 22rem;
		pointer-events: none;
		z-index: 0;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--olive-soft) 40%, var(--caramel)) 0%,
			var(--olive-soft) 4.5rem,
			color-mix(in srgb, var(--ground) 55%, var(--olive-soft)) 12rem,
			var(--ground) 100%
		);
	}

	body.inner-page > :not(.page-atmosphere) {
		position: relative;
		z-index: 1;
	}
</style>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	.title {
		width: min(40rem, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 2rem 0 1.75rem;
		text-align: left;
		line-height: 1.2;
	}

	.title h1 {
		margin: 0 0 0.45em;
		font-size: clamp(2.1rem, 5vw, 2.85rem);
		max-width: 14ch;
	}

	.page-desc {
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.55;
		color: var(--quiet);
		max-width: 34em;
	}

	.date {
		margin-bottom: 0.65em;
		color: var(--quiet);
		font-size: 0.95rem;
	}

	.last-updated-on {
		font-style: italic;
	}

	.prose {
		width: min(40rem, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 0 0 4rem;
		color: var(--ink);
	}

	@media (max-width: 720px) {
		.title {
			padding: 1.5rem 0 1.35rem;
		}
	}
</style>
